# Active Pydantic Settings values use double-underscore nesting.
APPLICATION__ENVIRONMENT=development
APPLICATION__DEBUG=false
SERVER__HOST=0.0.0.0
SERVER__PORT=8000

# AI providers (leave credentials empty until configured).
OPENAI__API_KEY=
OPENAI__MODEL=openai/gpt-oss-20b
OPENAI__BASE_URL=https://api.groq.com/openai/v1
HUGGINGFACE__API_KEY=
HUGGINGFACE__EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Telegram integration.
TELEGRAM__BOT_TOKEN=
TELEGRAM__WEBHOOK_SECRET=
TELEGRAM__REQUEST_TIMEOUT_SECONDS=10.0

# Persistence and chat limits.
DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/atlas_ai
CHAT__HISTORY_LIMIT=20

# Authentication. Use a strong unique value outside local development.
AUTH__JWT_SECRET_KEY=
AUTH__JWT_ALGORITHM=HS256
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=60

# Workspace document ingestion settings.
DOCUMENTS__STORAGE_DIRECTORY=data/uploads/documents
DOCUMENTS__MAX_UPLOAD_SIZE_BYTES=10485760
DOCUMENTS__ALLOWED_EXTENSIONS=[".pdf", ".txt", ".docx"]
DOCUMENTS__ALLOWED_CONTENT_TYPES=["application/pdf", "text/plain", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]

# Finance provider settings.
FINANCE__FINNHUB_API_KEY=
FINANCE__SEC_USER_AGENT=
FINANCE__REQUEST_TIMEOUT_SECONDS=10.0
